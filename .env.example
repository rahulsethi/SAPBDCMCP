# Copy to .env and fill values as needed.
# v0.1 is contract-first; no secrets required for mock mode.

BDC_MODE=local               # local|hybrid|mock
BDC_MOCK_MODE=1              # 1 enables fixtures for ORD/CSN
BDC_VERIFY_TLS=1             # 1 verifies TLS for HTTP fetches
BDC_MAX_DOC_KB=512

# Comma-separated list of ORD sources (URLs or file paths)
# Example: BDC_ORD_SOURCES=https://example.com/ord.json,./fixtures/ord.json
BDC_ORD_SOURCES=./fixtures/ord.sample.json

# Plugins (comma-separated dotted module paths)
# Example: BDC_PLUGINS=sap_bdc_mcp.plugins.example
BDC_PLUGINS=

# Write tools are OFF by default. Leave off for v0.1.
BDC_ENABLE_WRITE_TOOLS=0
